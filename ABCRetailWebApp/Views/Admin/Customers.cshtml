@model IEnumerable<ABCRetailWebApp.Models.CustomerEntity>

@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <h1>Customer Directory</h1>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Province</th>
                        <th>Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-500">@c.FirstName @c.LastName</td>
                            <td class="text-small" style="font-family:monospace;">@c.Email</td>
                            <td class="text-small text-muted">@c.Phone</td>
                            <td class="text-small">@c.City</td>
                            <td class="text-small text-muted">@c.Province</td>
                            <td>
                                @if (c.UserType == "Admin")
                                {
                                    <span class="badge" style="background:var(--purple-100);color:var(--purple-700);font-size:0.72rem;">
                                        <i class="bi bi-shield-lock me-1"></i>Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:var(--neutral-100);color:var(--neutral-600);font-size:0.72rem;">
                                        <i class="bi bi-person me-1"></i>Customer
                                    </span>
                                }
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge-stock">Active</span>
                                }
                                else
                                {
                                    <span class="badge-out">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Dashboard" class="btn btn-brand-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>
