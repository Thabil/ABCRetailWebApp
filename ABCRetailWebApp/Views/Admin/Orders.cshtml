@model IEnumerable<ABCRetailWebApp.Models.OrderEntity>

@{
    ViewData["Title"] = "Orders";
}

<!-- Toast -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999;">
    <div id="shipToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-500" id="toastMessage"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>Orders</h1>
    <a asp-action="FunctionActivity" class="btn btn-brand-outline btn-sm">
        <i class="bi bi-activity me-1"></i>Function Activity
    </a>
</div>
<p class="text-muted text-small mb-4">
    All orders from Azure Table Storage. Orders in <strong>Processing</strong> have been picked up by
    <code>OrderProcessingFunction</code> — ship them here when ready to dispatch.
</p>

@if (TempData["Success"] != null)
{
    <div class="alert-success-soft mb-4">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr id="row-@order.RowKey">
                            <td class="text-small fw-500" style="font-family:monospace;">@order.OrderId</td>
                            <td>
                                <div class="fw-500">@order.CustomerName</div>
                                <div class="text-muted text-small">@order.CustomerEmail</div>
                            </td>
                            <td class="text-small">
                                @if (!string.IsNullOrEmpty(order.OrderItemsJson))
                                {
                                    try
                                    {
                                        var items = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(order.OrderItemsJson!);
                                        if (items != null)
                                        {
                                            foreach (var item in items)
                                            {
                                                var name = item.TryGetProperty("ProductName", out var n) ? n.GetString() : "Item";
                                                var qty  = item.TryGetProperty("Quantity",    out var q) ? q.GetInt32() : 1;
                                                <span class="badge" style="background:var(--neutral-100);color:var(--neutral-700);font-size:0.72rem;">@name ×@qty</span>
                                            }
                                        }
                                    }
                                    catch { <span class="text-muted">—</span> }
                                }
                            </td>
                            <td class="text-price fw-600">R @(((decimal)order.TotalAmount).ToString("F2"))</td>
                            <td class="text-small text-muted">@order.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (order.PaymentStatus == "Paid")
                                {
                                    <span class="badge-stock"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@order.PaymentStatus</span>
                                }
                            </td>
                            <td id="status-@order.RowKey">
                                @switch (order.OrderStatus)
                                {
                                    case "Processing":
                                        <span class="badge bg-info text-white"><i class="bi bi-arrow-repeat me-1"></i>Processing</span>
                                        break;
                                    case "Shipped":
                                        <span class="badge bg-primary"><i class="bi bi-truck me-1"></i>Shipped</span>
                                        break;
                                    case "Delivered":
                                        <span class="badge-stock"><i class="bi bi-check2-circle me-1"></i>Delivered</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge-out"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@order.OrderStatus</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (order.OrderStatus == "Processing" || order.OrderStatus == "Pending")
                                {
                                    <button class="btn btn-sm btn-brand ship-btn"
                                            data-pk="@order.PartitionKey"
                                            data-rk="@order.RowKey">
                                        <i class="bi bi-truck me-1"></i>Ship
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted text-small">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-inbox me-2"></i>No orders yet
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Dashboard" class="btn btn-brand-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
    <a asp-action="FunctionActivity" class="btn btn-brand-outline btn-sm">
        <i class="bi bi-activity me-1"></i>Function Activity
    </a>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const toastEl = document.getElementById('shipToast');
    const toastMsg = document.getElementById('toastMessage');
    const toast = new bootstrap.Toast(toastEl, { delay: 4000 });

    function showToast(message, success) {
        toastEl.classList.remove('bg-success', 'bg-danger', 'text-white');
        toastEl.classList.add(success ? 'bg-success' : 'bg-danger', 'text-white');
        toastMsg.textContent = message;
        toast.show();
    }

    document.querySelectorAll('.ship-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const pk = btn.dataset.pk;
            const rk = btn.dataset.rk;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Shipping...';

            const res  = await fetch('/Admin/ShipOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `partitionKey=${encodeURIComponent(pk)}&rowKey=${encodeURIComponent(rk)}`
            });
            const data = await res.json();
            showToast(data.message, data.success);

            if (data.success) {
                document.getElementById(`status-${rk}`).innerHTML =
                    '<span class="badge bg-primary"><i class="bi bi-truck me-1"></i>Shipped</span>';
                btn.closest('td').innerHTML = '<span class="text-muted text-small">—</span>';
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-truck me-1"></i>Ship';
            }
        });
    });
</script>
}
