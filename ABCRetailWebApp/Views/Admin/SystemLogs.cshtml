@model List<(string Name, string Content)>

@{
    ViewData["Title"] = "System Logs";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>System Logs</h1>
    <div class="d-flex gap-2">
        <a asp-action="SystemLogs" asp-route-logType="orders" class="btn btn-brand-outline btn-sm">Orders</a>
        <a asp-action="SystemLogs" asp-route-logType="queue" class="btn btn-brand-outline btn-sm">Queue</a>
        <a asp-action="SystemLogs" class="btn btn-brand-outline btn-sm">All</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-journal-x"></i></div>
        <h5>No log files found</h5>
        <p>Logs are written when orders are placed or queue messages are processed.</p>
    </div>
}
else
{
    @foreach (var log in Model)
    {
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-file-text text-muted"></i>
                <span class="fw-500">@log.Name</span>
            </div>
            <div class="card-body p-0">
                <pre style="margin:0; padding:1rem; font-size:0.78rem; background:var(--neutral-50,#f8f8f8);
                            max-height:320px; overflow-y:auto; border-radius:0 0 8px 8px;">@log.Content</pre>
            </div>
        </div>
    }
}

<div class="mt-3">
    <a asp-action="Dashboard" class="btn btn-brand-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>
