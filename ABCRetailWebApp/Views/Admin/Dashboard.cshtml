@model ABCRetailWebApp.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>Admin Portal</h1>
    <div class="d-flex gap-2 align-items-center">
        <form asp-action="VerifyStock" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-search me-1"></i>Verify Inventory Stock
            </button>
        </form>
        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-box-arrow-right me-1"></i>Sign Out
            </button>
        </form>
    </div>
</div>
<p class="text-muted text-small mb-4">
    Operational dashboard monitoring Azure Storage services status.
</p>

@if (TempData["Success"] != null)
{
    <div class="alert-success-soft mb-4">@TempData["Success"]</div>
}
@if (TempData["StockError"] != null)
{
    <div class="alert alert-danger mb-4">@TempData["StockError"]</div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-people"></i>
            </div>
            <div class="stat-label">Customers</div>
            <div class="stat-value">@Model.TotalCustomers</div>
            <a href="@Url.Action("Customers")" class="stat-link">
                View directory <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-success">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="stat-label">Inventory Items</div>
            <div class="stat-value">@Model.InventoryItems</div>
            <a href="@Url.Action("Inventory")" class="stat-link">
                Manage stock <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-warning">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-label">Pending Orders</div>
            <div class="stat-value">@Model.PendingOrders</div>
            <a href="@Url.Action("Orders")" class="stat-link">
                Manage orders <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-info">
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="stat-label">Audit Log Entries</div>
            <div class="stat-value">@Model.AuditLogEntries</div>
            <a href="@Url.Action("SystemLogs")" class="stat-link">
                Read logs <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-danger" style="background:rgba(220,53,69,.12);color:#dc3545;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="stat-label">Stock Alerts</div>
            <div class="stat-value">@Model.StockAlertCount</div>
            <a href="@Url.Action("FunctionActivity")" class="stat-link">
                View alerts <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- Out of Stock Alert Card -->
@if (Model.OutOfStockProducts.Any())
{
    <div class="card mb-4 border-danger">
        <div class="card-header text-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>Out of Stock Products (@Model.OutOfStockProducts.Count)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Stock</th>
                            <th>Restock (qty > 10)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.OutOfStockProducts)
                        {
                            <tr>
                                <td class="fw-500">@p.ProductName</td>
                                <td><span class="category-pill" style="font-size:0.75rem;">@p.Category</span></td>
                                <td><span class="badge-out"><i class="bi bi-x-circle me-1"></i>@p.StockQuantity</span></td>
                                <td>
                                    <form asp-action="UpdateStock" method="post" class="d-flex gap-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="partitionKey" value="@p.PartitionKey" />
                                        <input type="hidden" name="rowKey" value="@p.RowKey" />
                                        <input type="number" name="quantityToAdd" min="11" placeholder="e.g. 20"
                                               class="form-control form-control-sm" style="width:100px;" required />
                                        <button type="submit" class="btn btn-sm btn-brand">Restock</button>
                                    </form>
                                </td>
                                <td>
                                    <form asp-action="DeleteProduct" method="post"
                                          onsubmit="return confirm('Delete @Html.Raw(p.ProductName?.Replace("'", "\\'")??"")? This cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="partitionKey" value="@p.PartitionKey" />
                                        <input type="hidden" name="rowKey" value="@p.RowKey" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Infrastructure Overview -->
<div class="card mb-4">
    <div class="card-header">Infrastructure Overview</div>
    <div class="card-body">
        <p class="text-muted text-small mb-3">
            Real-time status of Azure Storage endpoints powering this application.
        </p>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Resource</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.Infrastructure)
                    {
                        <tr>
                            <td>@item.Service</td>
                            <td>@item.ResourceName</td>
                            <td><span class="badge-stock">@item.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card">
    <div class="card-header">Quick Actions</div>
    <div class="card-body">
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("AddProduct")" class="btn btn-brand btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
            <a href="@Url.Action("Orders")" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-bag-check me-1"></i>Manage Orders
            </a>
            <a href="@Url.Action("FunctionActivity")" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-activity me-1"></i>Function Activity
            </a>
            <a href="@Url.Action("SystemLogs")" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-journal-text me-1"></i>System Logs
            </a>
            <a href="@Url.Action("Inventory")" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-box-seam me-1"></i>Inventory
            </a>
        </div>
    </div>
</div>
