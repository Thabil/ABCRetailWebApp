@model ABCRetailWebApp.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>Admin Portal</h1>
    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-brand-outline btn-sm">
            <i class="bi bi-box-arrow-right me-1"></i>Sign Out
        </button>
    </form>
</div>
<p class="text-muted text-small mb-4">
    Operational dashboard monitoring Azure Storage services status.
</p>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="bi bi-people"></i>
            </div>
            <div class="stat-label">Customers</div>
            <div class="stat-value">@Model.TotalCustomers</div>
            <a href="@Url.Action("Customers")" class="stat-link">
                View directory <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-success">
                <i class="bi bi-box-seam"></i>
            </div>
            <div class="stat-label">Inventory Items</div>
            <div class="stat-value">@Model.InventoryItems</div>
            <a href="@Url.Action("Inventory")" class="stat-link">
                Manage stock <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-warning">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-label">Pending Orders</div>
            <div class="stat-value">@Model.PendingOrders</div>
            <a href="@Url.Action("Queue")" class="stat-link">
                Process queue <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-info">
                <i class="bi bi-journal-text"></i>
            </div>
            <div class="stat-label">Audit Log Entries</div>
            <div class="stat-value">@Model.AuditLogEntries</div>
            <a href="@Url.Action("SystemLogs")" class="stat-link">
                Read logs <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- Infrastructure Overview -->
<div class="card mb-4">
    <div class="card-header">Infrastructure Overview</div>
    <div class="card-body">
        <p class="text-muted text-small mb-3">
            Real-time status of Azure Storage endpoints powering this application.
        </p>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Resource</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.Infrastructure)
                    {
                        <tr>
                            <td>@item.Service</td>
                            <td>@item.ResourceName</td>
                            <td><span class="badge-stock">@item.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card">
    <div class="card-header">Quick Actions</div>
    <div class="card-body">
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("AddProduct")" class="btn btn-brand btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
            <a href="@Url.Action("Queue")" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i>Order Queue
            </a>
            <a href="@Url.Action("SystemLogs")" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-journal-text me-1"></i>System Logs
            </a>
            <a href="@Url.Action("Inventory")" class="btn btn-brand-outline btn-sm">
                <i class="bi bi-box-seam me-1"></i>Inventory
            </a>
        </div>
    </div>
</div>
