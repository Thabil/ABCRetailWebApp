@model IEnumerable<ABCRetailWebApp.Models.ProductEntity>

@{
    ViewData["Title"] = "Inventory";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>Inventory</h1>
    <a asp-action="AddProduct" class="btn btn-brand btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Product
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success-soft mb-4">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Brand</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var priceDisplay = ((decimal)p.Price).ToString("F2");
                        <tr>
                            <td class="fw-500">@p.ProductName</td>
                            <td><span class="category-pill" style="font-size:0.75rem;">@p.Category</span></td>
                            <td class="text-price">R @priceDisplay</td>
                            <td>
                                @if (p.StockQuantity > 10)
                                {
                                    <span class="badge-stock"><i class="bi bi-check-circle me-1"></i>@p.StockQuantity</span>
                                }
                                else if (p.StockQuantity > 0)
                                {
                                    <span class="badge bg-warning text-dark">Low: @p.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="badge-out"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>
                                }
                            </td>
                            <td class="text-muted text-small">@p.Brand</td>
                            <td>
                                @if (p.IsAvailable)
                                {
                                    <span class="badge-stock">Active</span>
                                }
                                else
                                {
                                    <span class="badge-out">Inactive</span>
                                }
                            </td>
                            <td>
                                <form asp-action="DeleteProduct" method="post"
                                      onsubmit="return confirm('Delete @p.ProductName?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="partitionKey" value="@p.PartitionKey" />
                                    <input type="hidden" name="rowKey" value="@p.RowKey" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Dashboard" class="btn btn-brand-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>
