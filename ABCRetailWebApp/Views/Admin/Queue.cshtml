@model IEnumerable<ABCRetailWebApp.Models.QueueMessageModel>
@using System.Text.Json

@{
    ViewData["Title"] = "Order Queue";

    string OrderSummary(string? content)
    {
        if (string.IsNullOrEmpty(content)) return "(empty)";
        try
        {
            var doc = JsonDocument.Parse(content);
            var r   = doc.RootElement;
            var id   = r.TryGetProperty("orderId",      out var o) ? o.GetString() : null;
            var name = r.TryGetProperty("customerName", out var n) ? n.GetString() : null;
            var tot  = r.TryGetProperty("total",        out var t) ? t.GetDecimal().ToString("F2") : null;
            if (id != null) return $"{id} | {name} | R{tot}";
        }
        catch { }
        return content;
    }
}

<!-- Toast notification -->
<div class="position-fixed top-0 end-0 p-3" style="z-index:9999;">
    <div id="queueToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-500" id="toastMessage"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div class="page-header d-flex justify-content-between align-items-center">
    <h1>Order Queue</h1>
    <div class="d-flex gap-2">
        <button id="processNextBtn" class="btn btn-brand btn-sm">
            <i class="bi bi-skip-end-fill me-1"></i>Process Next
        </button>
        <form asp-action="PurgeQueue" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash3 me-1"></i>Purge Queue
            </button>
        </form>
    </div>
</div>
<p class="text-muted text-small mb-4">Pending order messages from Azure Queue Storage.</p>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Message</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="queueTableBody">
                    @if (!Model.Any())
                    {
                        <tr id="emptyRow">
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="bi bi-inbox me-2"></i>No messages in queue
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var msg in Model)
                        {
                            <tr class="@(msg.IsPoisoned ? "table-danger" : "")">  
                                <td class="text-small text-muted">@msg.Timestamp?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    @if (msg.IsPoisoned)
                                    {
                                        <span class="badge bg-danger me-2">FAILED</span>
                                    }
                                    @OrderSummary(msg.Content)
                                </td>
                                <td>
                                    @if (!msg.IsPoisoned)
                                    {
                                        <button type="button" class="btn btn-sm btn-brand process-btn">
                                            <i class="bi bi-play-fill me-1"></i>Process
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted text-small">Poison — purge to clear</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Dashboard" class="btn btn-brand-outline btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const toastEl = document.getElementById('queueToast');
    const toastMsg = document.getElementById('toastMessage');
    const toast = new bootstrap.Toast(toastEl, { delay: 4000 });

    function showToast(message, success) {
        toastEl.classList.remove('bg-success', 'bg-danger', 'text-white');
        toastEl.classList.add(success ? 'bg-success' : 'bg-danger', 'text-white');
        toastMsg.textContent = message;
        toast.show();
    }

    async function processNext() {
        const res = await fetch('/Admin/ProcessNextMessage', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token }
        });
        const data = await res.json();
        showToast(data.message, data.success);
        if (data.success) {
            // Remove the first data row from the table
            const tbody = document.getElementById('queueTableBody');
            const rows = tbody.querySelectorAll('tr:not(#emptyRow)');
            if (rows.length > 0) {
                rows[0].remove();
                if (tbody.querySelectorAll('tr:not(#emptyRow)').length === 0) {
                    tbody.innerHTML = `<tr id="emptyRow"><td colspan="3" class="text-center text-muted py-4"><i class="bi bi-inbox me-2"></i>No messages in queue</td></tr>`;
                }
            }
        }
    }

    document.getElementById('processNextBtn').addEventListener('click', processNext);
    document.querySelectorAll('.process-btn').forEach(btn => btn.addEventListener('click', processNext));
</script>
}
