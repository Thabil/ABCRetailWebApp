@model IEnumerable<ABCRetailWebApp.Models.OrderEntity>

@{
    ViewData["Title"] = "My Orders";
}

<div class="page-header">
    <h1>My Orders</h1>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-box"></i></div>
        <h5>No orders yet</h5>
        <p>You haven't placed any orders yet.</p>
        <a asp-action="Index" class="btn btn-brand mt-2">
            <i class="bi bi-bag me-1"></i>Browse Products
        </a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Items</th>
                            <th>Total Paid</th>
                            <th>Date</th>
                            <th>Payment</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var totalDisplay = ((decimal)order.TotalAmount).ToString("F2");
                            <tr>
                                <td class="fw-500 text-small" style="font-family:monospace;">@order.OrderId</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(order.OrderItemsJson))
                                    {
                                        try
                                        {
                                            var items = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(order.OrderItemsJson!);
                                            if (items != null)
                                            {
                                                foreach (var item in items)
                                                {
                                                    var name = item.TryGetProperty("ProductName", out var n) ? n.GetString() : "Item";
                                                    var qty  = item.TryGetProperty("Quantity", out var q) ? q.GetInt32() : 1;
                                                    <span class="badge" style="background:var(--neutral-100);color:var(--neutral-700);font-size:0.72rem;">@name x @qty</span>
                                                }
                                            }
                                        }
                                        catch { <span class="text-muted text-small">—</span> }
                                    }
                                </td>
                                <td class="text-price fw-600">R @totalDisplay</td>
                                <td class="text-small text-muted">@order.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (order.PaymentStatus == "Paid")
                                    {
                                        <span class="badge-stock"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@order.PaymentStatus</span>
                                    }
                                </td>
                                <td>
                                    @switch (order.OrderStatus)
                                    {
                                        case "Processing":
                                            <span class="badge bg-info text-white">
                                                <i class="bi bi-arrow-repeat me-1"></i>Processing
                                            </span>
                                            break;
                                        case "Shipped":
                                            <span class="badge bg-primary">
                                                <i class="bi bi-truck me-1"></i>Shipped
                                            </span>
                                            break;
                                        case "Delivered":
                                            <span class="badge-stock">
                                                <i class="bi bi-check2-circle me-1"></i>Delivered
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge-out">
                                                <i class="bi bi-x-circle me-1"></i>Cancelled
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@order.OrderStatus</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-brand-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Continue Shopping
        </a>
    </div>
}
