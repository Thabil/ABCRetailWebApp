@model (ABCRetailWebApp.Models.ProductEntity Product, string? SasUrl)

@{
    var imgSrc = !string.IsNullOrEmpty(Model.SasUrl)
        ? Model.SasUrl
        : Model.Product.ImageUrl;
}

<div class="card product-card h-100">
    @if (!string.IsNullOrEmpty(imgSrc))
    {
        <img src="@imgSrc" class="card-img-top" alt="@Model.Product.ProductName"
             style="height:200px; object-fit:cover;">
    }
    else
    {
        <div class="product-img-placeholder">
            <i class="bi bi-image"></i>
        </div>
    }
    <div class="card-body d-flex flex-column">
        <p class="product-category">@Model.Product.Category</p>
        @{ var priceDisplay = ((decimal)Model.Product.Price).ToString("F2"); }
        <h5 class="product-name">@Model.Product.ProductName</h5>
        <p class="product-price">R @priceDisplay</p>
        <div class="mb-3">
            @if (Model.Product.StockQuantity > 0)
            {
                <span class="badge-stock">
                    <i class="bi bi-check-circle me-1"></i>In Stock (@Model.Product.StockQuantity)
                </span>
            }
            else
            {
                <span class="badge-out">
                    <i class="bi bi-x-circle me-1"></i>Out of Stock
                </span>
            }
        </div>
        <form asp-action="AddToCart" method="post" class="mt-auto">
            <input type="hidden" name="productId" value="@Model.Product.RowKey" />
            <div class="d-flex gap-2">
                <input type="number" name="quantity" value="1" min="1"
                       max="@Model.Product.StockQuantity"
                       class="form-control form-control-sm" style="width:68px;"
                       aria-label="Quantity" />
                <button type="submit" class="btn btn-brand btn-sm flex-grow-1"
                        @(Model.Product.StockQuantity <= 0 ? "disabled" : "")>
                    <i class="bi bi-bag-plus me-1"></i>Add to Cart
                </button>
            </div>
        </form>
    </div>
</div>