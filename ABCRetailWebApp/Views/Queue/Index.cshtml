@model IEnumerable<string>

<h1>Queue Messages</h1>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h4>Product Events Queue</h4>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">No messages in queue</div>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var message in Model)
                        {
                            <li class="list-group-item">@message</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>