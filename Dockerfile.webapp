FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ABCRetailWebApp/ABCRetailWebApp.csproj ./ABCRetailWebApp/
RUN dotnet restore ABCRetailWebApp/ABCRetailWebApp.csproj
COPY ABCRetailWebApp/ ./ABCRetailWebApp/
RUN dotnet publish ABCRetailWebApp/ABCRetailWebApp.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "ABCRetailWebApp.dll"]
